# JWT Settings
JWT_SECRET_KEY=your-secure-secret-key-here  # Generate with: openssl rand -hex 32
JWT_ACCESS_TOKEN_EXPIRES=1800  # 30 minutes
JWT_REFRESH_TOKEN_EXPIRES=604800  # 7 days

# Security Settings
ENFORCE_HTTPS=false  # Set to true in production
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW=60  # Time window in seconds
RATE_LIMIT_MAX=30  # Maximum requests per window

# Server Settings
PORT=8000
DEBUG=false
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Database Settings
# Add your database connection settings here
